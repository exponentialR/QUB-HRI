# Copy this file to .env and set the directory containing videos/ and landmarks/.
# .env stays local and is ignored by Git. Use quotes for paths containing spaces.
QUB_PHEO_DATASET_ROOT="/path/to/qub-pheo-dataset"

# Optional overrides for a different directory layout:
# QUB_PHEO_VIDEO_ROOT="/path/to/videos"
# QUB_PHEO_LANDMARKS_ROOT="/path/to/landmarks"

QUB_PHEO_VIEWER_PORT=8767

# Optional: show an existing UL/UR coverage report in the viewer.
# QUB_PHEO_QUALITY_ROOT="/path/to/final_quality_v1"

# Values are literal; shell commands and ${VARIABLE} expansion are not evaluated.
# Relative paths in this file resolve from this file's directory. ~ is supported.
